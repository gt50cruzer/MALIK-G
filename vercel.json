{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth.php",
      "destination": "/api/auth"
    },
    {
      "source": "/api/orders.php",
      "destination": "/api/orders"
    },
    {
      "source": "/api/products.php",
      "destination": "/api/products"
    },
    {
      "source": "/api/categories.php",
      "destination": "/api/categories"
    },
    {
      "source": "/api/dashboard.php",
      "destination": "/api/dashboard"
    },
    {
      "source": "/api/upload.php",
      "destination": "/api/upload"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
